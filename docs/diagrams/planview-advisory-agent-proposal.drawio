<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="page1" name="Planview Advisory Agent — Proposal"><mxGraphModel dx="2400" dy="2090" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2090" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_t" value="&lt;b style=&quot;font-size:30px&quot;&gt;Planview Advisory Agent — what we can build on Microsoft&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="2320" height="50" as="geometry"/></mxCell><mxCell id="p1_ban" value="&lt;b&gt;The idea:&lt;/b&gt; an Avantra AI advisor that sits &lt;b&gt;between Planview and our customers&lt;/b&gt;. It &lt;b&gt;attracts&lt;/b&gt; prospects, runs &lt;b&gt;discovery&lt;/b&gt;, &lt;b&gt;recommends&lt;/b&gt; the right Planview products with sources, helps customers &lt;b&gt;use&lt;/b&gt; Planview, and hands &lt;b&gt;qualified, services-rich opportunities&lt;/b&gt; to our team. Built &lt;b&gt;100% on Microsoft&lt;/b&gt;: Microsoft Foundry, Azure OpenAI, Azure AI Search, Azure SQL, Container Apps, Teams, Dynamics 365 and Power BI. A working prototype already runs on public Planview content." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0b3d91;strokeColor=#0b3d91;fontSize=16;align=left;verticalAlign=middle;spacing=8;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="2320" height="95" as="geometry"/></mxCell><mxCell id="p1_hd0" value="&lt;b&gt;① Who uses it&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="320" height="40" as="geometry"/></mxCell><mxCell id="p1_hd1" value="&lt;b&gt;② Where they meet it&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="420" y="190" width="340" height="40" as="geometry"/></mxCell><mxCell id="p1_hd2" value="&lt;b&gt;③ The Advisory Agent&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="820" y="190" width="560" height="40" as="geometry"/></mxCell><mxCell id="p1_hd3" value="&lt;b&gt;④ What the agent uses&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1440" y="190" width="420" height="40" as="geometry"/></mxCell><mxCell id="p1_hd4" value="&lt;b&gt;⑤ What feeds it&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1920" y="190" width="440" height="40" as="geometry"/></mxCell><mxCell id="p1_pp0" value="&lt;b&gt;Prospects&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;companies exploring portfolio, resource and work management&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="245" width="320" height="190" as="geometry"/></mxCell><mxCell id="p1_ch0" value="&lt;b&gt;Avantra website &amp;amp; Marketplace&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;chat widget: &quot;Is Planview right for us?&quot;&lt;br&gt;protected by Azure Front Door + WAF&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="420" y="245" width="340" height="190" as="geometry"/></mxCell><mxCell id="p1_pp1" value="&lt;b&gt;Planview customers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;already use Planview and want more value from it&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="320" height="190" as="geometry"/></mxCell><mxCell id="p1_ch1" value="&lt;b&gt;Customer portal chat&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;product questions and guidance for existing customers&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="420" y="460" width="340" height="190" as="geometry"/></mxCell><mxCell id="p1_pp2" value="&lt;b&gt;Avantra sales, pre-sales &amp;amp; consultants&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;run discovery and prepare proposals faster&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="675" width="320" height="190" as="geometry"/></mxCell><mxCell id="p1_ch2" value="&lt;b&gt;Microsoft Teams &amp;amp; Nexa&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Teams via Copilot Studio · Nexa via MCP · same agent, same answers&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="420" y="675" width="340" height="190" as="geometry"/></mxCell><mxCell id="p1_zag" value="Avantra Advisory Agent&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:normal&quot;&gt;.NET · Microsoft Agent Framework · Azure Container Apps · powered by Microsoft Foundry&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="820" y="245" width="560" height="620" as="geometry"/></mxCell><mxCell id="p1_orch" value="&lt;b&gt;Every conversation:&lt;/b&gt;&lt;br&gt;1 Understand the need → 2 Search Planview knowledge → 3 Match products with Avantra rules → 4 Answer with sources → 5 Hand off to our team" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="840" y="307" width="520" height="95" as="geometry"/></mxCell><mxCell id="p1_sk0" value="&lt;b&gt;Discovery&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;pain points, size, tools, qualification&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="840" y="417" width="255" height="135" as="geometry"/></mxCell><mxCell id="p1_sk1" value="&lt;b&gt;Recommendation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;products, fit, gaps, quote inputs (no prices)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1105" y="417" width="255" height="135" as="geometry"/></mxCell><mxCell id="p1_sk2" value="&lt;b&gt;Product Q&amp;amp;A&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;&quot;how do I…&quot; answers from Planview docs&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="840" y="567" width="255" height="135" as="geometry"/></mxCell><mxCell id="p1_sk3" value="&lt;b&gt;Proposal &amp;amp; services&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;solution outline, integrations, training&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1105" y="567" width="255" height="135" as="geometry"/></mxCell><mxCell id="p1_guard" value="&lt;b&gt;Guardrails:&lt;/b&gt; Azure AI Content Safety + Prompt Shields · facts only from approved sources · every answer cites its page · no invented prices · consultant approves before formal customer documents" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="840" y="725" width="520" height="125" as="geometry"/></mxCell><mxCell id="p1_us0" value="&lt;b&gt;Azure OpenAI in Microsoft Foundry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;understands questions and writes answers · our own deployment · our data is not used to train models&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1440" y="245" width="420" height="190" as="geometry"/></mxCell><mxCell id="p1_fd0" value="&lt;b&gt;Microsoft Foundry quality loop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;evaluations (accuracy, groundedness) before every release · tracing · user feedback&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1920" y="245" width="440" height="190" as="geometry"/></mxCell><mxCell id="p1_us1" value="&lt;b&gt;Azure AI Search&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;&lt;b&gt;planview-index&lt;/b&gt; (later salesforce-, outsystems-index) · keyword + meaning search&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1440" y="460" width="420" height="190" as="geometry"/></mxCell><mxCell id="p1_fd1" value="&lt;b&gt;Planview public website &amp;amp; docs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;www.planview.com + success.planview.com · refreshed daily · public pages only, no Planview API&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1920" y="460" width="440" height="190" as="geometry"/></mxCell><mxCell id="p1_us2" value="&lt;b&gt;Azure SQL Database&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Planview capability catalogue · conversations · discovery summaries · audit log&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1440" y="675" width="420" height="190" as="geometry"/></mxCell><mxCell id="p1_fd2" value="&lt;b&gt;Avantra knowledge (SharePoint)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;playbooks · discovery frameworks · delivery experience · catalogue validated by Ridhima&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1920" y="675" width="440" height="190" as="geometry"/></mxCell><mxCell id="p1_ctrl" value="&lt;b style=&quot;font-size:16px&quot;&gt;People stay in control&lt;/b&gt;&lt;br&gt;▸ Ridhima owns the Planview capability catalogue; changes are reviewed&lt;br&gt;▸ A consultant approves proposals before they reach a customer&lt;br&gt;▸ Customers can ask for a person at any time; the agent hands over with full context" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="915" width="720" height="180" as="geometry"/></mxCell><mxCell id="p1_out" value="&lt;b style=&quot;font-size:16px&quot;&gt;What comes out&lt;/b&gt;&lt;br&gt;&lt;b&gt;Customer:&lt;/b&gt; sourced answers + discovery summary&lt;br&gt;&lt;b&gt;Sales:&lt;/b&gt; qualified lead in Dynamics 365 / CRM + Teams alert&lt;br&gt;&lt;b&gt;Management:&lt;/b&gt; Power BI dashboard — leads, top needs, gaps, services pipeline" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="820" y="915" width="560" height="180" as="geometry"/></mxCell><mxCell id="p1_stack" value="&lt;b style=&quot;font-size:16px&quot;&gt;All Microsoft&lt;/b&gt;&lt;br&gt;AI: Microsoft Foundry · Azure OpenAI · Azure AI Search · Content Safety · Microsoft Agent Framework (.NET)&lt;br&gt;Run: Azure Container Apps · Azure SQL · API Management · Front Door + WAF · Key Vault · Entra ID&lt;br&gt;Govern: Purview · Defender for Cloud · Azure Monitor / App Insights · Cost Management&lt;br&gt;Reach: Teams · Copilot Studio · Dynamics 365 · Power BI · SharePoint" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1440" y="915" width="920" height="180" as="geometry"/></mxCell><mxCell id="p1_bh" value="&lt;b style=&quot;font-size:22px&quot;&gt;What we can build — agent possibilities along the customer journey&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="1130" width="2320" height="40" as="geometry"/></mxCell><mxCell id="p1_cd0" value="&lt;b style=&quot;font-size:15px&quot;&gt;1 · ATTRACT&lt;/b&gt;&lt;br&gt;&lt;b&gt;Website &quot;Planview fit check&quot;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;5-minute guided chat on our website and Marketplace; captures needs and contact details and creates a lead&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Phase 2 · customer-facing&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1180" width="370" height="215" as="geometry"/></mxCell><mxCell id="p1_cd1" value="&lt;b style=&quot;font-size:15px&quot;&gt;2 · DISCOVER&lt;/b&gt;&lt;br&gt;&lt;b&gt;Discovery conversation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;pain points, size, roles, current tools; live qualification and next questions&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Phase 1 · prototype works&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="430" y="1180" width="370" height="215" as="geometry"/></mxCell><mxCell id="p1_cd2" value="&lt;b style=&quot;font-size:15px&quot;&gt;3 · RECOMMEND&lt;/b&gt;&lt;br&gt;&lt;b&gt;Products &amp;amp; capabilities&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;best-fit Planview products, gaps and alternatives with sources; licensing quote inputs, never prices&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Phase 1 · prototype works&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="820" y="1180" width="370" height="215" as="geometry"/></mxCell><mxCell id="p1_cd3" value="&lt;b style=&quot;font-size:15px&quot;&gt;4 · PROPOSE&lt;/b&gt;&lt;br&gt;&lt;b&gt;Solution outline&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;draft solution and Avantra services (integration, migration, training) for the consultant to edit&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Phase 2&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1210" y="1180" width="370" height="215" as="geometry"/></mxCell><mxCell id="p1_cd4" value="&lt;b style=&quot;font-size:15px&quot;&gt;5 · ADOPT&lt;/b&gt;&lt;br&gt;&lt;b&gt;Customer product help&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;&quot;how do I…&quot; answers from Planview docs, onboarding guides, best practices&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Phase 3&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=15;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1600" y="1180" width="370" height="215" as="geometry"/></mxCell><mxCell id="p1_cd5" value="&lt;b style=&quot;font-size:15px&quot;&gt;6 · GROW&lt;/b&gt;&lt;br&gt;&lt;b&gt;Expansion &amp;amp; services&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;spots upsell and services needs from customer questions; prepares account reviews&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Phase 3&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=15;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1990" y="1180" width="370" height="215" as="geometry"/></mxCell><mxCell id="p1_ph" value="&lt;b style=&quot;font-size:22px&quot;&gt;How we run it — governance, security, budget, timeline, scale&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="1440" width="2320" height="40" as="geometry"/></mxCell><mxCell id="p1_pl0" value="&lt;b style=&quot;font-size:18px&quot;&gt;Governance&lt;/b&gt;&lt;br&gt;▸ Microsoft Foundry evaluations before each release (accuracy, groundedness)&lt;br&gt;▸ Facts only from approved sources; every answer cites its page&lt;br&gt;▸ No invented prices or licence tiers, only quote inputs&lt;br&gt;▸ Content owner per vendor (Planview: Ridhima); changes reviewed&lt;br&gt;▸ Consultant approves formal customer documents&lt;br&gt;▸ Full audit log; Microsoft Purview for classification and retention&lt;br&gt;▸ Public Planview content only; Legal confirms use" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1490" width="448" height="310" as="geometry"/></mxCell><mxCell id="p1_pl1" value="&lt;b style=&quot;font-size:18px&quot;&gt;Security&lt;/b&gt;&lt;br&gt;▸ Login and roles from our existing platform (Entra ID); public chat is anonymous and rate-limited&lt;br&gt;▸ Managed identities, no passwords in code; secrets in Key Vault&lt;br&gt;▸ Private endpoints for SQL, Search and OpenAI&lt;br&gt;▸ Front Door + WAF; Prompt Shields block prompt attacks&lt;br&gt;▸ Data stays in our Azure tenant and region&lt;br&gt;▸ Defender for Cloud and Azure Monitor alerts&lt;br&gt;▸ No access to customer Planview systems needed" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="508" y="1490" width="448" height="310" as="geometry"/></mxCell><mxCell id="p1_pl2" value="&lt;b style=&quot;font-size:18px&quot;&gt;Budget (indicative)&lt;/b&gt;&lt;br&gt;▸ &lt;b&gt;Pilot, 8 weeks:&lt;/b&gt; ~12–14 person-weeks (architect ~60%, 1 .NET developer, Ridhima 10–15%)&lt;br&gt;▸ &lt;b&gt;Azure, pilot:&lt;/b&gt; USD 150–400 / month&lt;br&gt;▸ &lt;b&gt;Azure, production:&lt;/b&gt; USD 650–1,750 / month (high availability)&lt;br&gt;▸ Full Planview content load: a few dollars, one-off&lt;br&gt;▸ Not included: Copilot Studio licences if we use the Teams channel (check our Microsoft agreement)&lt;br&gt;▸ Azure budgets + alerts; API Management sets AI token limits per channel&lt;br&gt;▸ From public Azure list prices; confirm in the pricing calculator" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="976" y="1490" width="448" height="310" as="geometry"/></mxCell><mxCell id="p1_pl3" value="&lt;b style=&quot;font-size:18px&quot;&gt;Timeline&lt;/b&gt;&lt;br&gt;▸ &lt;b&gt;Weeks 1–2:&lt;/b&gt; Ridhima validates content; full Planview load&lt;br&gt;▸ &lt;b&gt;Weeks 3–4:&lt;/b&gt; qualification and services in the report&lt;br&gt;▸ &lt;b&gt;Weeks 5–6:&lt;/b&gt; deploy on our Azure; connect Nexa and Azure OpenAI&lt;br&gt;▸ &lt;b&gt;Weeks 7–8:&lt;/b&gt; pilot with 5–10 sales users → go / no-go&lt;br&gt;▸ &lt;b&gt;Months 3–4:&lt;/b&gt; production for sales; Teams; CRM hand-off&lt;br&gt;▸ &lt;b&gt;Months 4–6:&lt;/b&gt; website fit check (Attract) and customer help (Adopt)&lt;br&gt;▸ &lt;b&gt;Months 6–9:&lt;/b&gt; Salesforce and OutSystems knowledge bases" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1444" y="1490" width="448" height="310" as="geometry"/></mxCell><mxCell id="p1_pl4" value="&lt;b style=&quot;font-size:18px&quot;&gt;Scale&lt;/b&gt;&lt;br&gt;▸ &lt;b&gt;Users:&lt;/b&gt; Container Apps autoscale; scales to zero when idle&lt;br&gt;▸ &lt;b&gt;Knowledge:&lt;/b&gt; one AI Search index per vendor; add replicas as usage grows&lt;br&gt;▸ &lt;b&gt;AI capacity:&lt;/b&gt; pay-as-you-go, then provisioned throughput when usage is steady&lt;br&gt;▸ &lt;b&gt;Vendors:&lt;/b&gt; new vendor = new knowledge base + sources, no rebuild&lt;br&gt;▸ &lt;b&gt;Channels:&lt;/b&gt; one agent serves website, Teams, Nexa and CRM through the same MCP / API&lt;br&gt;▸ &lt;b&gt;Availability:&lt;/b&gt; second Azure region when customer-facing&lt;br&gt;▸ &lt;b&gt;Languages:&lt;/b&gt; answers in the customer's language" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1912" y="1490" width="448" height="310" as="geometry"/></mxCell><mxCell id="p1_kh" value="&lt;b style=&quot;font-size:22px&quot;&gt;Benefits (pilot targets) and decisions needed&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="1835" width="2320" height="40" as="geometry"/></mxCell><mxCell id="p1_kp0" value="&lt;b style=&quot;font-size:22px&quot;&gt;Minutes, not days&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;first sourced recommendation (target under 15 min)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1885" width="300" height="140" as="geometry"/></mxCell><mxCell id="p1_kp1" value="&lt;b style=&quot;font-size:22px&quot;&gt;80%+&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;recommendations accepted by consultants with minor edits&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="360" y="1885" width="300" height="140" as="geometry"/></mxCell><mxCell id="p1_kp2" value="&lt;b style=&quot;font-size:22px&quot;&gt;More services revenue&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;gaps and integrations found early&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="680" y="1885" width="300" height="140" as="geometry"/></mxCell><mxCell id="p1_kp3" value="&lt;b style=&quot;font-size:22px&quot;&gt;24/7 lead capture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;website agent attracts and qualifies prospects&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1000" y="1885" width="300" height="140" as="geometry"/></mxCell><mxCell id="p1_kp4" value="&lt;b style=&quot;font-size:22px&quot;&gt;Expert time freed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Ridhima and senior consultants focus on complex deals&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="1885" width="300" height="140" as="geometry"/></mxCell><mxCell id="p1_dec" value="&lt;b style=&quot;font-size:16px&quot;&gt;Decisions for management&lt;/b&gt;&lt;br&gt;① Approve the 8-week Planview pilot and one .NET developer&lt;br&gt;② Confirm Ridhima's time (10–15%)&lt;br&gt;③ Azure subscription + Microsoft Foundry project; Nexa connects via MCP&lt;br&gt;④ When to open customer-facing channels (after the pilot)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1640" y="1885" width="720" height="140" as="geometry"/></mxCell><mxCell id="p1_foot" value="&lt;i&gt;Benefits are pilot targets, not measured results. Costs are indicative, from public Azure list prices. Months 3–9 are a proposed roadmap after a go decision.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="2040" width="2320" height="30" as="geometry"/></mxCell><mxCell id="p1_a_pc0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_pp0" target="p1_ch0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a_ca0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=3;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1532258064516129;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_ch0" target="p1_zag"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a_pc1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_pp1" target="p1_ch1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a_ca1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=3;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_ch1" target="p1_zag"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a_pc2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_pp2" target="p1_ch2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a_ca2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=3;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8467741935483871;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_ch2" target="p1_zag"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a_au0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=3;endArrow=block;endFill=1;exitX=1;exitY=0.1532258064516129;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_zag" target="p1_us0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a_fu0" value="evaluate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2.5;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_fd0" target="p1_us0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a_au1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=3;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_zag" target="p1_us1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a_fu1" value="crawl daily" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2.5;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_fd1" target="p1_us1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a_au2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=3;endArrow=block;endFill=1;exitX=1;exitY=0.8467741935483871;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_zag" target="p1_us2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a_fu2" value="upload &amp;amp; curate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2.5;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_fd2" target="p1_us2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a_out" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=3;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_zag" target="p1_out"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a_cd1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_cd0" target="p1_cd1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a_cd2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_cd1" target="p1_cd2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a_cd3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_cd2" target="p1_cd3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a_cd4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_cd3" target="p1_cd4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a_cd5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_cd4" target="p1_cd5"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
