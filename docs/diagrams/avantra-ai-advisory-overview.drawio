<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="page1" name="1. High-Level Architecture"><mxGraphModel dx="2100" dy="2280" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="2280" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_t" value="&lt;b style=&quot;font-size:28px&quot;&gt;Avantra AI Advisory — High-Level Architecture&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="2020" height="50" as="geometry"/></mxCell><mxCell id="p1_def" value="&lt;b&gt;How it works:&lt;/b&gt; one &lt;b&gt;MCP client page&lt;/b&gt; shows every tool from every connector. It talks to one &lt;b&gt;Advisory Agent&lt;/b&gt; (.NET) that exposes an &lt;b&gt;MCP server&lt;/b&gt;. The agent routes each question to the right &lt;b&gt;connector&lt;/b&gt; — Planview, Salesforce or OutSystems. Each connector has its &lt;b&gt;own knowledge base (its own Azure AI Search index)&lt;/b&gt; filled only from &lt;b&gt;public sources&lt;/b&gt; (vendor websites and documentation) and Avantra documents — &lt;b&gt;no vendor APIs&lt;/b&gt;. &lt;b&gt;We build Planview first&lt;/b&gt;, then repeat the same pattern." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0b3d91;strokeColor=#0b3d91;fontSize=15;align=left;verticalAlign=middle;spacing=8;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="2020" height="80" as="geometry"/></mxCell><mxCell id="p1_hd0" value="&lt;b&gt;MCP Client&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="175" width="300" height="40" as="geometry"/></mxCell><mxCell id="p1_hd1" value="&lt;b&gt;Advisory Agent&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="420" y="175" width="340" height="40" as="geometry"/></mxCell><mxCell id="p1_hd2" value="&lt;b&gt;Connectors (MCP tools)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="840" y="175" width="360" height="40" as="geometry"/></mxCell><mxCell id="p1_hd3" value="&lt;b&gt;Knowledge base — one AI Search index each&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1280" y="175" width="330" height="40" as="geometry"/></mxCell><mxCell id="p1_hd4" value="&lt;b&gt;Public sources (crawled, refreshed daily)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1690" y="175" width="370" height="40" as="geometry"/></mxCell><mxCell id="p1_client" value="&lt;b style=&quot;font-size:17px&quot;&gt;MCP Client — one page&lt;/b&gt;&lt;br&gt;Nexa · Advisory Workspace&lt;br&gt;&lt;br&gt;&lt;b&gt;Shows all tools from all connectors:&lt;/b&gt;&lt;br&gt;▸ discovery_chat / discovery_summary&lt;br&gt;▸ knowledge_search (per knowledge base)&lt;br&gt;▸ advisory_recommend / compare&lt;br&gt;▸ ask_advisor (agentic)&lt;br&gt;&lt;br&gt;&lt;b&gt;Customer Discovery page:&lt;/b&gt;&lt;br&gt;chat on the left, live discovery on the right: profile, pain points, requirements, recommendation, qualification, services opportunities, next questions" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="300" height="780" as="geometry"/></mxCell><mxCell id="p1_agent" value="&lt;b style=&quot;font-size:17px&quot;&gt;Avantra Advisory Agent&lt;/b&gt;&lt;br&gt;.NET · Microsoft Agent Framework&lt;br&gt;&lt;b&gt;Exposes one MCP server&lt;/b&gt; (all connector tools + ask_advisor)&lt;br&gt;&lt;br&gt;&lt;b&gt;For every message:&lt;/b&gt;&lt;br&gt;1. Understand the need / pain&lt;br&gt;2. Pick the connector(s)&lt;br&gt;3. Search the knowledge base&lt;br&gt;4. Rank products with fixed rules&lt;br&gt;5. Update qualification &amp;amp; services&lt;br&gt;6. Reply with sources&lt;br&gt;&lt;br&gt;&lt;b&gt;Rules it follows:&lt;/b&gt;&lt;br&gt;▸ facts only from the knowledge base&lt;br&gt;▸ every answer shows its source&lt;br&gt;▸ no invented prices or tiers&lt;br&gt;▸ unknowns become follow-up questions&lt;br&gt;&lt;br&gt;&lt;b&gt;AI model:&lt;/b&gt; Azure OpenAI (configurable)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="420" y="230" width="340" height="780" as="geometry"/></mxCell><mxCell id="p1_con0" value="&lt;b style=&quot;font-size:16px&quot;&gt;Planview Connector&lt;/b&gt;&lt;br&gt;&lt;i&gt;Portfolio &amp;amp; work management&lt;/i&gt;&lt;br&gt;&lt;b&gt;Phase 1 — start here&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Tools: knowledge_search · advisory_recommend · advisory_compare · advisory_licensing · discovery_chat (knowledgeBase = planview)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="840" y="230" width="360" height="240" as="geometry"/></mxCell><mxCell id="p1_idx0" value="&lt;b&gt;planview-index&lt;/b&gt;&lt;br&gt;Azure AI Search&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;product pages · documentation · Avantra playbooks · keyword + vector search&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1280" y="240" width="330" height="120" as="geometry"/></mxCell><mxCell id="p1_api0" value="&lt;b&gt;Planview public sources&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;www.planview.com · success.planview.com (public docs)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1690" y="380" width="370" height="80" as="geometry"/></mxCell><mxCell id="p1_con1" value="&lt;b style=&quot;font-size:16px&quot;&gt;Salesforce Connector&lt;/b&gt;&lt;br&gt;&lt;i&gt;CRM &amp;amp; customer engagement&lt;/i&gt;&lt;br&gt;&lt;b&gt;Phase 2&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Tools: same tools with knowledgeBase = salesforce&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="840" y="500" width="360" height="240" as="geometry"/></mxCell><mxCell id="p1_idx1" value="&lt;b&gt;salesforce-index&lt;/b&gt;&lt;br&gt;Azure AI Search&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;clouds · editions · public list prices (cited) · keyword + vector search&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1280" y="510" width="330" height="120" as="geometry"/></mxCell><mxCell id="p1_api1" value="&lt;b&gt;Salesforce public sources&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;salesforce.com product pages · help.salesforce.com&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1690" y="650" width="370" height="80" as="geometry"/></mxCell><mxCell id="p1_con2" value="&lt;b style=&quot;font-size:16px&quot;&gt;OutSystems Connector&lt;/b&gt;&lt;br&gt;&lt;i&gt;Low-code application platform&lt;/i&gt;&lt;br&gt;&lt;b&gt;Phase 3&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Tools: same tools with knowledgeBase = outsystems&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="840" y="770" width="360" height="240" as="geometry"/></mxCell><mxCell id="p1_idx2" value="&lt;b&gt;outsystems-index&lt;/b&gt;&lt;br&gt;Azure AI Search&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;ODC · OutSystems 11 · capacity sizing · keyword + vector search&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1280" y="780" width="330" height="120" as="geometry"/></mxCell><mxCell id="p1_api2" value="&lt;b&gt;OutSystems public sources&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;outsystems.com · success.outsystems.com&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1690" y="920" width="370" height="80" as="geometry"/></mxCell><mxCell id="p1_exh" value="&lt;b style=&quot;font-size:20px&quot;&gt;Planview example — one discovery conversation, end to end&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="2020" height="36" as="geometry"/></mxCell><mxCell id="p1_ex0" value="&lt;b&gt;1. Ask&lt;/b&gt;&lt;br&gt;In the MCP client: &quot;We have 2,000 staff, 150 project managers and 40 portfolio managers — which Planview products do we need?&quot;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1085" width="370" height="140" as="geometry"/></mxCell><mxCell id="p1_ex1" value="&lt;b&gt;2. Route&lt;/b&gt;&lt;br&gt;The agent sees a Planview question and uses the &lt;b&gt;Planview connector&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="452" y="1085" width="370" height="140" as="geometry"/></mxCell><mxCell id="p1_ex2" value="&lt;b&gt;3. Search&lt;/b&gt;&lt;br&gt;knowledge_search → &lt;b&gt;planview-index&lt;/b&gt; returns product facts with their sources" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="864" y="1085" width="370" height="140" as="geometry"/></mxCell><mxCell id="p1_ex3" value="&lt;b&gt;4. Qualify&lt;/b&gt;&lt;br&gt;Pain points, fit %, discovery completeness, ~users → &lt;b&gt;Qualified for solution workshop&lt;/b&gt;; services: Jira integration, migration from MS Project" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1276" y="1085" width="370" height="140" as="geometry"/></mxCell><mxCell id="p1_ex4" value="&lt;b&gt;5. Answer&lt;/b&gt;&lt;br&gt;&lt;b&gt;Planview Portfolios&lt;/b&gt; recommended · why it fits · gaps · sources · what to confirm with Planview for licensing" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1688" y="1085" width="370" height="140" as="geometry"/></mxCell><mxCell id="p1_order" value="&lt;b&gt;Build order:&lt;/b&gt; &amp;nbsp; ① &lt;b&gt;Planview&lt;/b&gt; connector + planview-index (public sources) &amp;nbsp;→&amp;nbsp; ② &lt;b&gt;Salesforce&lt;/b&gt; &amp;nbsp;→&amp;nbsp; ③ &lt;b&gt;OutSystems&lt;/b&gt;. Each new vendor = &lt;b&gt;one new connector + one new index&lt;/b&gt;; the agent and the MCP client stay the same, and their tools appear on the client page automatically." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1255" width="2020" height="70" as="geometry"/></mxCell><mxCell id="p1_foot" value="&lt;b&gt;Why separate indexes:&lt;/b&gt; each team owns and refreshes its own vendor knowledge, answers never mix vendors by accident, and an index can be rebuilt without touching the others. &amp;nbsp; &lt;b&gt;One tool set for all vendors&lt;/b&gt;: tools take a knowledgeBase code, so new vendors need no new tools. &lt;b&gt;No vendor APIs&lt;/b&gt; are used — public sources only." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1340" width="2020" height="70" as="geometry"/></mxCell><mxCell id="p1_zkb" value="How the Planview knowledge base is built — public sources only, no Planview API" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="40" y="1440" width="2020" height="820" as="geometry"/></mxCell><mxCell id="p1_ks0" value="&lt;b&gt;www.planview.com&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;products · solutions · guides · articles&lt;br&gt;~600 English pages (7 sitemaps)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="1500" width="280" height="100" as="geometry"/></mxCell><mxCell id="p1_ks1" value="&lt;b&gt;success.planview.com&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;product documentation&lt;br&gt;~12,500 public pages&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="1620" width="280" height="100" as="geometry"/></mxCell><mxCell id="p1_ks2" value="&lt;b&gt;Avantra documents&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;playbooks · discovery frameworks&lt;br&gt;uploaded in the Knowledge panel&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="1740" width="280" height="100" as="geometry"/></mxCell><mxCell id="p1_kf0" value="&lt;b&gt;1. Discover&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;read sitemaps · obey robots.txt · skip campaign, trial, careers and &lt;b&gt;sign-in-only&lt;/b&gt; pages&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="420" y="1605" width="280" height="130" as="geometry"/></mxCell><mxCell id="p1_kf1" value="&lt;b&gt;2. Fetch politely&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;1 page/s (website) · 5 s (docs, as Planview asks) · only pages &lt;b&gt;changed&lt;/b&gt; since last run&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="734" y="1605" width="280" height="130" as="geometry"/></mxCell><mxCell id="p1_kf2" value="&lt;b&gt;3. Clean &amp;amp; check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;keep the main text only (no menus, forms, footers) · unsafe content quarantined&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1048" y="1605" width="280" height="130" as="geometry"/></mxCell><mxCell id="p1_kf3" value="&lt;b&gt;4. Split &amp;amp; tag&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;by heading into passages · tagged with Planview &lt;b&gt;products&lt;/b&gt; and &lt;b&gt;capabilities&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1362" y="1605" width="280" height="130" as="geometry"/></mxCell><mxCell id="p1_kf4" value="&lt;b&gt;5. Store &amp;amp; index&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;database keeps versions + source URL · &lt;b&gt;planview-index&lt;/b&gt;: keyword + meaning search&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1676" y="1605" width="280" height="130" as="geometry"/></mxCell><mxCell id="p1_kuse" value="&lt;b&gt;Used by the Discovery agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;answers questions with the Planview page as source · evidence behind every recommendation&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1592" y="1780" width="448" height="95" as="geometry"/></mxCell><mxCell id="p1_kcat" value="&lt;b&gt;Planview capability catalogue (the &quot;brain&quot; for recommendations)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Capabilities · products · which product covers which need · licensing disclosure · Avantra delivery rules. Curated and &lt;b&gt;verified by the Planview expert (Ridhima)&lt;/b&gt;; crawled pages are its evidence. Decides recommendations — documents never do on their own.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="1900" width="1950" height="95" as="geometry"/></mxCell><mxCell id="p1_kst0" value="&lt;b style=&quot;font-size:24px&quot;&gt;13,121&lt;/b&gt;&lt;br&gt;eligible public pages found" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="2025" width="370" height="90" as="geometry"/></mxCell><mxCell id="p1_kst1" value="&lt;b style=&quot;font-size:24px&quot;&gt;~700&lt;/b&gt;&lt;br&gt;loaded in the first test run (22 min)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="464" y="2025" width="370" height="90" as="geometry"/></mxCell><mxCell id="p1_kst2" value="&lt;b style=&quot;font-size:24px&quot;&gt;~18 h&lt;/b&gt;&lt;br&gt;first full load (docs ask 5 s/page)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="858" y="2025" width="370" height="90" as="geometry"/></mxCell><mxCell id="p1_kst3" value="&lt;b style=&quot;font-size:24px&quot;&gt;Minutes&lt;/b&gt;&lt;br&gt;daily refresh: only changed pages" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1252" y="2025" width="370" height="90" as="geometry"/></mxCell><mxCell id="p1_kst4" value="&lt;b style=&quot;font-size:24px&quot;&gt;0&lt;/b&gt;&lt;br&gt;Planview APIs or customer systems used" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1646" y="2025" width="370" height="90" as="geometry"/></mxCell><mxCell id="p1_knote" value="&lt;b&gt;Safeguards:&lt;/b&gt; only allowed public hosts · same-site redirects only · customer-only (sign-in) documentation is skipped (e.g. Portfolios docs) · each page keeps its URL so answers can cite it · a stuck page never stops the run · crawls can be cancelled · confirm Planview's website terms before the full load. &amp;nbsp; &lt;b&gt;Same pattern for Salesforce and OutSystems:&lt;/b&gt; add their public sitemaps to their own knowledge base — no code changes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="70" y="2135" width="1950" height="100" as="geometry"/></mxCell><mxCell id="p1_a_ca" value="MCP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=4;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_client" target="p1_agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a_ag0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=3;endArrow=block;endFill=1;exitX=1;exitY=0.15384615384615385;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_agent" target="p1_con0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a_kb0" value="search" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.2916666666666667;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_con0" target="p1_idx0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a_ap0" value="crawl → index" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.7916666666666666;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_con0" target="p1_api0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a_ag1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=3;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_agent" target="p1_con1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a_kb1" value="search" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.2916666666666667;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_con1" target="p1_idx1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a_ap1" value="crawl → index" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.7916666666666666;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_con1" target="p1_api1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a_ag2" value="" s