<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="page1" name="1. High-Level Architecture"><mxGraphModel dx="1900" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_t" value="&lt;b style=&quot;font-size:28px&quot;&gt;Avantra AI Advisory Platform — High-Level Architecture&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1820" height="50" as="geometry"/></mxCell><mxCell id="p1_def" value="&lt;b&gt;In one sentence:&lt;/b&gt; a customer or salesperson describes what they need → the platform picks the right vendor products using &lt;b&gt;fixed business rules over a checked product catalogue&lt;/b&gt;, backs every claim with a &lt;b&gt;source&lt;/b&gt;, uses &lt;b&gt;AI only to read the request and write the summary&lt;/b&gt;, and a &lt;b&gt;person approves&lt;/b&gt; the report before it reaches a customer." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0b3d91;strokeColor=#0b3d91;fontSize=15;align=left;verticalAlign=middle;spacing=8;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="1820" height="70" as="geometry"/></mxCell><mxCell id="p1_z0" value="Users" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="320" height="560" as="geometry"/></mxCell><mxCell id="p1_b0_0" value="&lt;b&gt;Sales &amp;amp; Pre-sales&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ask for recommendations&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="65" y="230" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b0_1" value="&lt;b&gt;Solution Architects&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;review &amp;amp; approve&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="65" y="352" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b0_2" value="&lt;b&gt;Knowledge Curators&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;keep product data correct&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="65" y="475" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b0_3" value="&lt;b&gt;Customers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;later: self-service&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=15;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="65" y="597" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_z1" value="Channels" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="415" y="170" width="320" height="560" as="geometry"/></mxCell><mxCell id="p1_b1_0" value="&lt;b&gt;Nexa Chatbot&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;connects via MCP&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="440" y="230" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b1_1" value="&lt;b&gt;Advisory Web App&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Blazor&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="440" y="352" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b1_2" value="&lt;b&gt;Avantra Marketplace&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;connects via REST API&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="440" y="475" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b1_3" value="&lt;b&gt;Teams / CRM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;later&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=15;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="440" y="597" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_z2" value="Secure Access" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="790" y="170" width="320" height="560" as="geometry"/></mxCell><mxCell id="p1_b2_0" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;login · roles · tenants&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="815" y="230" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b2_1" value="&lt;b&gt;API Management&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;gateway · rate limits&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="815" y="393" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b2_2" value="&lt;b&gt;Azure Front Door&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;WAF · HTTPS&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="815" y="556" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_z3" value="Advisory Platform (.NET 10)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="1165" y="170" width="320" height="560" as="geometry"/></mxCell><mxCell id="p1_b3_0" value="&lt;b&gt;REST API + MCP Server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;one entry for every channel&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1190" y="230" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b3_1" value="&lt;b&gt;Advisory Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;rules pick products · cites sources&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1190" y="352" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b3_2" value="&lt;b&gt;AI Layer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;reads requests · writes summaries&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1190" y="475" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b3_3" value="&lt;b&gt;Knowledge Base&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;vendor packs + documents&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1190" y="597" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_z4" value="Data &amp;amp; AI Services" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="1540" y="170" width="320" height="560" as="geometry"/></mxCell><mxCell id="p1_b4_0" value="&lt;b&gt;Azure OpenAI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;AI model (swappable)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1565" y="230" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b4_1" value="&lt;b&gt;Azure AI Search&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;finds supporting documents&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1565" y="352" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b4_2" value="&lt;b&gt;Azure SQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;sessions · audit · documents&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1565" y="475" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b4_3" value="&lt;b&gt;Blob Storage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;original files&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1565" y="597" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_strip" value="&lt;b&gt;Cross-cutting:&lt;/b&gt; &amp;nbsp; hosted on Azure Container Apps &amp;nbsp;·&amp;nbsp; secrets in Key Vault (managed identity) &amp;nbsp;·&amp;nbsp; monitoring in Application Insights &amp;nbsp;·&amp;nbsp; every run audited &amp;nbsp;·&amp;nbsp; data separated per tenant and per vendor &amp;nbsp;·&amp;nbsp; &lt;b&gt;human approval before customer sharing&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1820" height="60" as="geometry"/></mxCell><mxCell id="p1_s0" value="&lt;b style=&quot;font-size:20px&quot;&gt;1&lt;/b&gt;&lt;br&gt;User describes the need&lt;br&gt;(people, goals, tools)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="320" height="100" as="geometry"/></mxCell><mxCell id="p1_s1" value="&lt;b style=&quot;font-size:20px&quot;&gt;2&lt;/b&gt;&lt;br&gt;Channel sends the request&lt;br&gt;(chat, web or marketplace)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="415" y="850" width="320" height="100" as="geometry"/></mxCell><mxCell id="p1_s2" value="&lt;b style=&quot;font-size:20px&quot;&gt;3&lt;/b&gt;&lt;br&gt;Login and role are checked&lt;br&gt;(who you are, what you may do)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="790" y="850" width="320" height="100" as="geometry"/></mxCell><mxCell id="p1_s3" value="&lt;b style=&quot;font-size:20px&quot;&gt;4&lt;/b&gt;&lt;br&gt;Engine picks products,&lt;br&gt;asks follow-up questions, cites sources" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1165" y="850" width="320" height="100" as="geometry"/></mxCell><mxCell id="p1_s4" value="&lt;b style=&quot;font-size:20px&quot;&gt;5&lt;/b&gt;&lt;br&gt;AI model, search and database&lt;br&gt;are used → draft report" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1540" y="850" width="320" height="100" as="geometry"/></mxCell><mxCell id="p1_foot" value="Vendors: &lt;b&gt;Planview&lt;/b&gt; now · Salesforce and OutSystems next — added as new data packs, no new platform code." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="975" width="1820" height="40" as="geometry"/></mxCell><mxCell id="p1_a0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=4;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_z0" target="p1_z1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=4;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_z1" target="p1_z2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=4;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_z2" target="p1_z3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=4;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_z3" target="p1_z4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_sa0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_s0" target="p1_s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_sa1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_s1" target="p1_s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_sa2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_s2" target="p1_s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_sa3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_s3" target="p1_s4"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="2. Low-Level Design"><mxGraphModel dx="2500" dy="1420" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1420" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2_t" value="&lt;b style=&quot;font-size:28px&quot;&gt;Low-Level Design — how one advisory request is processed&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="2260" height="50" as="geometry"/></mxCell><mxCell id="p2_zA" value="A. Advisory request pipeline (inside the API service)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2420" height="700" as="geometry"/></mxCell><mxCell id="p2_c1" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Nexa · Web App · Marketplace&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="230" height="80" as="geometry"/></mxCell><mxCell id="p2_c2" value="&lt;b&gt;REST /api/v1  or  MCP /mcp&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;same services behind both&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="290" width="230" height="80" as="geometry"/></mxCell><mxCell id="p2_c3" value="&lt;b&gt;Security&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Entra token → role → tenant&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="440" width="230" height="80" as="geometry"/></mxCell><mxCell id="p2_st0" value="&lt;b&gt;1. Validate input&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;size limit · hide card/ID numbers · flag injection&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="440" width="225" height="80" as="geometry"/></mxCell><mxCell id="p2_st1" value="&lt;b&gt;2. Understand needs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;org size, roles, must-haves&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="588" y="440" width="225" height="80" as="geometry"/></mxCell><mxCell id="p2_st2" value="&lt;b&gt;3. Follow-up questions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ask for missing facts&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="836" y="440" width="225" height="80" as="geometry"/></mxCell><mxCell id="p2_st3" value="&lt;b&gt;4. Pick products&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;score product bundles by coverage&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1084" y="440" width="225" height="80" as="geometry"/></mxCell><mxCell id="p2_st4" value="&lt;b&gt;5. Add evidence&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;citation for every claim&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1332" y="440" width="225" height="80" as="geometry"/></mxCell><mxCell id="p2_st5" value="&lt;b&gt;6. Licensing check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;sizing inputs · never prices&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1580" y="440" width="225" height="80" as="geometry"/></mxCell><mxCell id="p2_st6" value="&lt;b&gt;7. Write summary&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;AI text, then safety check&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1828" y="440" width="225" height="80" as="geometry"/></mxCell><mxCell id="p2_st7" value="&lt;b&gt;8. Save &amp;amp; return&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Draft session + audit entry&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="2076" y="440" width="225" height="80" as="geometry"/></mxCell><mxCell id="p2_sp1" value="&lt;b&gt;AI Extractor + Rule Extractor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;AI result checked against product list&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="588" y="570" width="225" height="80" as="geometry"/></mxCell><mxCell id="p2_d1" value="&lt;b&gt;AI Model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Azure OpenAI or own endpoint&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="588" y="680" width="225" height="70" as="geometry"/></mxCell><mxCell id="p2_sp3" value="&lt;b&gt;Recommendation Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;fixed rules · same input → same answer&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1084" y="570" width="225" height="80" as="geometry"/></mxCell><mxCell id="p2_d3" value="&lt;b&gt;Vendor Pack&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;products · capabilities · rules&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1084" y="680" width="225" height="70" as="geometry"/></mxCell><mxCell id="p2_sp4" value="&lt;b&gt;Knowledge Search&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;keyword + meaning, per vendor&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1332" y="570" width="225" height="80" as="geometry"/></mxCell><mxCell id="p2_d4" value="&lt;b&gt;Azure AI Search&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;document index&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1332" y="680" width="225" height="70" as="geometry"/></mxCell><mxCell id="p2_sp6" value="&lt;b&gt;Summary Writer + Guard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;blocks prices / unknown products&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1828" y="570" width="225" height="80" as="geometry"/></mxCell><mxCell id="p2_d6" value="&lt;b&gt;AI Model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;same model as step 2&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1828" y="680" width="225" height="70" as="geometry"/></mxCell><mxCell id="p2_sp7" value="&lt;b&gt;Session Store + Audit Log&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;separated per tenant&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="2076" y="570" width="225" height="80" as="geometry"/></mxCell><mxCell id="p2_d7" value="&lt;b&gt;Azure SQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;sessions · documents · audit&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="2076" y="680" width="225" height="70" as="geometry"/></mxCell><mxCell id="p2_rev" value="&lt;b&gt;Reviewer approves → report&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Markdown / HTML · marked DRAFT until approved&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1998.5" y="140" width="380" height="80" as="geometry"/></mxCell><mxCell id="p2_fb" value="&lt;b&gt;Follow-up answers come back with the same sessionId&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;the pipeline re-runs with the full conversation&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="340" y="140" width="700" height="80" as="geometry"/></mxCell><mxCell id="p2_out" value="&lt;b&gt;Result sent back to client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;products · coverage · gaps · questions · sources · licensing notes&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1998.5" y="290" width="380" height="80" as="geometry"/></mxCell><mxCell id="p2_zB" value="B. Knowledge ingestion pipeline (adds vendor documents)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="2420" height="230" as="geometry"/></mxCell><mxCell id="p2_i0" value="&lt;b&gt;Upload / Job&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;admin or scheduled&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="880" width="222" height="90" as="geometry"/></mxCell><mxCell id="p2_i1" value="&lt;b&gt;Parse&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PDF · DOCX · HTML · MD&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="317" y="880" width="222" height="90" as="geometry"/></mxCell><mxCell id="p2_i2" value="&lt;b&gt;Safety scan&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;suspicious → quarantine&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="564" y="880" width="222" height="90" as="geometry"/></mxCell><mxCell id="p2_i3" value="&lt;b&gt;Split into chunks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;by section&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="811" y="880" width="222" height="90" as="geometry"/></mxCell><mxCell id="p2_i4" value="&lt;b&gt;Tag&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;products + capabilities&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1058" y="880" width="222" height="90" as="geometry"/></mxCell><mxCell id="p2_i5" value="&lt;b&gt;Embed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;optional vectors&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1305" y="880" width="222" height="90" as="geometry"/></mxCell><mxCell id="p2_i6" value="&lt;b&gt;Save&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;SQL + Blob, versioned&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1552" y="880" width="222" height="90" as="geometry"/></mxCell><mxCell id="p2_i7" value="&lt;b&gt;Curator publishes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;review step&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1799" y="880" width="222" height="90" as="geometry"/></mxCell><mxCell id="p2_i8" value="&lt;b&gt;Search index&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;now searchable&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="2046" y="880" width="222" height="90" as="geometry"/></mxCell><mxCell id="p2_zC" value="C. Code structure (.NET solution) — dependencies point inward" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="40" y="1070" width="2420" height="310" as="geometry"/></mxCell><mxCell id="p2_p0" value="&lt;b&gt;Avantra.AIAdvisory.Web&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Blazor UI&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="1140" width="250" height="90" as="geometry"/></mxCell><mxCell id="p2_p1" value="&lt;b&gt;Avantra.AIAdvisory.Api&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;host: REST + MCP + auth&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="354" y="1140" width="250" height="90" as="geometry"/></mxCell><mxCell id="p2_p2" value="&lt;b&gt;Avantra.AIAdvisory.McpServer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;10 MCP tools&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="638" y="1140" width="250" height="90" as="geometry"/></mxCell><mxCell id="p2_p3" value="&lt;b&gt;Avantra.AIAdvisory.Agents&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;AI extractor · summary · Q&amp;amp;A agent&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="922" y="1140" width="250" height="90" as="geometry"/></mxCell><mxCell id="p2_p4" value="&lt;b&gt;Avantra.AIAdvisory.KnowledgeBase&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;parsers · ingestion · search&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1206" y="1140" width="250" height="90" as="geometry"/></mxCell><mxCell id="p2_p5" value="&lt;b&gt;Avantra.AIAdvisory.Infrastructure&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;EF Core · audit · AI provider&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1490" y="1140" width="250" height="90" as="geometry"/></mxCell><mxCell id="p2_p6" value="&lt;b&gt;Avantra.AIAdvisory.Application&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;engine · pipeline · rules&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1774" y="1140" width="250" height="90" as="geometry"/></mxCell><mxCell id="p2_p7" value="&lt;b&gt;Avantra.AIAdvisory.Domain&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;core models, no dependencies&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="2058" y="1140" width="250" height="90" as="geometry"/></mxCell><mxCell id="p2_pnote" value="&lt;b&gt;Rule:&lt;/b&gt; Hosts (Web, Api) → adapters (McpServer, Agents, KnowledgeBase, Infrastructure) → &lt;b&gt;Application&lt;/b&gt; → &lt;b&gt;Domain&lt;/b&gt;. The core logic never depends on the database, the AI vendor or MCP, so each can be swapped or tested on its own. &amp;nbsp; Tests: 37 unit + 13 integration." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="1260" width="2360" height="90" as="geometry"/></mxCell><mxCell id="p2_ca1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=2.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_c1" target="p2_c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_ca2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=2.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_c2" target="p2_c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_sa0" value="" style="edgeStyle=orthogonalEdgeStyl