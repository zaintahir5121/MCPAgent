<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="page1" name="1. High-Level Architecture"><mxGraphModel dx="1900" dy="1900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_t" value="&lt;b style=&quot;font-size:28px&quot;&gt;Avantra AI Advisory Platform — High-Level Architecture&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1820" height="50" as="geometry"/></mxCell><mxCell id="p1_def" value="&lt;b&gt;What it does:&lt;/b&gt; turns a customer's business need into a &lt;b&gt;recommended vendor solution&lt;/b&gt; for &lt;b&gt;Planview, Salesforce or OutSystems&lt;/b&gt; — which products, why they fit, what is missing, what to confirm for licensing — backed by &lt;b&gt;sources&lt;/b&gt; and &lt;b&gt;Avantra delivery experience&lt;/b&gt;, ready as an &lt;b&gt;advisory report&lt;/b&gt;." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0b3d91;strokeColor=#0b3d91;fontSize=15;align=left;verticalAlign=middle;spacing=8;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="1820" height="70" as="geometry"/></mxCell><mxCell id="p1_z0" value="Who asks" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="320" height="560" as="geometry"/></mxCell><mxCell id="p1_b0_0" value="&lt;b&gt;Account Executive&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;qualifying an opportunity&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="65" y="230" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b0_1" value="&lt;b&gt;Pre-sales Solution Consultant&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;shaping the solution&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="65" y="352" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b0_2" value="&lt;b&gt;Customer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;exploring options on the Marketplace&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="65" y="475" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b0_3" value="&lt;b&gt;Product Knowledge Owner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;one per vendor · keeps knowledge current&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="65" y="597" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_z1" value="Where they ask" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="415" y="170" width="320" height="560" as="geometry"/></mxCell><mxCell id="p1_b1_0" value="&lt;b&gt;Nexa Chatbot&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;conversational advisory&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="440" y="230" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b1_1" value="&lt;b&gt;Advisory Workspace&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;web app for sales teams&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="440" y="393" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b1_2" value="&lt;b&gt;Avantra Marketplace&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&quot;Is this right for me?&quot;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="440" y="556" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_z2" value="Advisory Capabilities" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="790" y="170" width="320" height="560" as="geometry"/></mxCell><mxCell id="p1_b2_0" value="&lt;b&gt;Requirements Discovery&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;business need → requirement profile&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="815" y="230" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b2_1" value="&lt;b&gt;Solution Fit Analysis&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;match needs to vendor capabilities&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="815" y="352" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b2_2" value="&lt;b&gt;Licensing &amp;amp; Subscription Guidance&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;sizing inputs · what to confirm&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="815" y="475" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b2_3" value="&lt;b&gt;Advisory Report&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;recommendation · gaps · risks&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="815" y="597" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_z3" value="Vendor Knowledge Packs" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="1165" y="170" width="320" height="560" as="geometry"/></mxCell><mxCell id="p1_b3_0" value="&lt;b&gt;Planview&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;portfolio &amp;amp; work management&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1190" y="230" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b3_1" value="&lt;b&gt;Salesforce&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;CRM &amp;amp; customer engagement&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1190" y="352" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b3_2" value="&lt;b&gt;OutSystems&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;low-code application platform&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1190" y="475" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b3_3" value="&lt;b&gt;Avantra Delivery Experience&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;shared: fit rules · lessons learned&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1190" y="597" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_z4" value="Advisory Outcome" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="1540" y="170" width="320" height="560" as="geometry"/></mxCell><mxCell id="p1_b4_0" value="&lt;b&gt;Recommended Solution&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;product bundle + why it fits&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1565" y="230" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b4_1" value="&lt;b&gt;Alternatives Compared&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;with their gaps&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1565" y="352" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b4_2" value="&lt;b&gt;Gaps, Risks &amp;amp; Next Questions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;what is still unknown&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1565" y="475" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b4_3" value="&lt;b&gt;Customer-ready Report&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;after Solution Architect review&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1565" y="597" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_vdh" value="&lt;b style=&quot;font-size:20px&quot;&gt;Vendor domains we advise on&lt;/b&gt; &amp;nbsp; &lt;font style=&quot;font-size:13px&quot; color=&quot;#555555&quot;&gt;(one shared platform · one knowledge pack per vendor)&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="755" width="1820" height="36" as="geometry"/></mxCell><mxCell id="p1_zv0" value="Planview — Portfolio &amp;amp; work management" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="586" height="554" as="geometry"/></mxCell><mxCell id="p1_v0_0" value="&lt;b&gt;Customers ask:&lt;/b&gt; &quot;Which Planview products do we need for portfolio, resource and financial planning?&quot;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="55" y="848" width="556" height="62" as="geometry"/></mxCell><mxCell id="p1_v0_1" value="&lt;b&gt;We advise on:&lt;/b&gt; portfolio management · strategic planning · resource &amp;amp; capacity planning · financial planning · project governance · agile at scale · work collaboration" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="55" y="918" width="556" height="80" as="geometry"/></mxCell><mxCell id="p1_v0_2" value="&lt;b&gt;Product catalogue:&lt;/b&gt; Planview Portfolios · AdaptiveWork · AgilePlace · ProjectPlace · PPM Pro · Hub · Viz · IdeaPlace · Roadmaps" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="55" y="1006" width="556" height="80" as="geometry"/></mxCell><mxCell id="p1_v0_3" value="&lt;b&gt;Licensing guidance:&lt;/b&gt; Pricing not public → quote from Planview. We prepare sizing inputs: portfolio managers, project managers, resource managers, team members." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="55" y="1094" width="556" height="80" as="geometry"/></mxCell><mxCell id="p1_v0_4" value="&lt;b&gt;Example:&lt;/b&gt; 2,000 staff · 150 PMs · 40 portfolio managers · need portfolio, resource &amp;amp; financial planning → &lt;b&gt;Planview Portfolios&lt;/b&gt;; add &lt;b&gt;AgilePlace&lt;/b&gt; if teams are agile" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="55" y="1182" width="556" height="92" as="geometry"/></mxCell><mxCell id="p1_v0_5" value="&lt;b&gt;Status:&lt;/b&gt; &lt;b&gt;Live in MVP&lt;/b&gt; (demo data) · verify facts → sales pilot → live in Nexa" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="55" y="1282" width="556" height="52" as="geometry"/></mxCell><mxCell id="p1_zv1" value="Salesforce — CRM &amp;amp; customer engagement" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="657" y="800" width="586" height="554" as="geometry"/></mxCell><mxCell id="p1_v1_0" value="&lt;b&gt;Customers ask:&lt;/b&gt; &quot;Which Salesforce clouds and editions do our sales and service teams need?&quot;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="672" y="848" width="556" height="62" as="geometry"/></mxCell><mxCell id="p1_v1_1" value="&lt;b&gt;We advise on:&lt;/b&gt; sales automation · customer service · marketing automation · customer &amp;amp; partner portals · analytics · integration · AI agents · industry solutions" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="672" y="918" width="556" height="80" as="geometry"/></mxCell><mxCell id="p1_v1_2" value="&lt;b&gt;Product catalogue:&lt;/b&gt; Sales Cloud · Service Cloud · Marketing Cloud · Experience Cloud · Commerce Cloud · Data Cloud · Agentforce · Tableau · MuleSoft · industry clouds" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="672" y="1006" width="556" height="80" as="geometry"/></mxCell><mxCell id="p1_v1_3" value="&lt;b&gt;Licensing guidance:&lt;/b&gt; Editions and list prices are partly public → shown only with a cited source; final pricing from Salesforce. Sizing inputs: sales reps, service agents, partner &amp;amp; portal users." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="672" y="1094" width="556" height="80" as="geometry"/></mxCell><mxCell id="p1_v1_4" value="&lt;b&gt;Example:&lt;/b&gt; 300 sales reps + 80 service agents · need pipeline and case management → &lt;b&gt;Sales Cloud + Service Cloud&lt;/b&gt;; edition chosen by required features" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="672" y="1182" width="556" height="92" as="geometry"/></mxCell><mxCell id="p1_v1_5" value="&lt;b&gt;Status:&lt;/b&gt; &lt;b&gt;Next&lt;/b&gt; · build knowledge pack → verify → pilot → live" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="672" y="1282" width="556" height="52" as="geometry"/></mxCell><mxCell id="p1_zv2" value="OutSystems — Low-code application platform" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="1274" y="800" width="586" height="554" as="geometry"/></mxCell><mxCell id="p1_v2_0" value="&lt;b&gt;Customers ask:&lt;/b&gt; &quot;Should we build or modernise our apps with low-code, and what subscription size do we need?&quot;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1289" y="848" width="556" height="62" as="geometry"/></mxCell><mxCell id="p1_v2_1" value="&lt;b&gt;We advise on:&lt;/b&gt; web &amp;amp; mobile app development · workflow automation · integration · legacy modernisation · AI-assisted development · cloud vs self-managed hosting · governance" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1289" y="918" width="556" height="80" as="geometry"/></mxCell><mxCell id="p1_v2_2" value="&lt;b&gt;Product catalogue:&lt;/b&gt; OutSystems Developer Cloud (ODC) · OutSystems 11 · Mentor (AI-assisted development) · integration &amp;amp; workflow tooling" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1289" y="1006" width="556" height="80" as="geometry"/></mxCell><mxCell id="p1_v2_3" value="&lt;b&gt;Licensing guidance:&lt;/b&gt; Capacity-based subscription → confirm with OutSystems. Sizing inputs: number and size of apps, internal vs external users, environments." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1289" y="1094" width="556" height="80" as="geometry"/></mxCell><mxCell id="p1_v2_4" value="&lt;b&gt;Example:&lt;/b&gt; Replace 12 spreadsheet/Access apps · 500 internal users + a customer portal → &lt;b&gt;OutSystems platform&lt;/b&gt;; ODC vs OutSystems 11 decided by hosting needs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1289" y="1182" width="556" height="92" as="geometry"/></mxCell><mxCell id="p1_v2_5" value="&lt;b&gt;Status:&lt;/b&gt; &lt;b&gt;After Salesforce&lt;/b&gt; · build knowledge pack → verify → pilot → live" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1289" y="1282" width="556" height="52" as="geometry"/></mxCell><mxCell id="p1_vnote" value="&lt;i&gt;Salesforce and OutSystems details are planning outlines — product names, packaging and licensing are confirmed by each vendor's Product Knowledge Owner when the pack is built.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1385" width="1820" height="30" as="geometry"/></mxCell><mxCell id="p1_rh" value="&lt;b style=&quot;font-size:20px&quot;&gt;Rollout plan by vendor&lt;/b&gt; &amp;nbsp; &lt;font style=&quot;font-size:13px&quot; color=&quot;#555555&quot;&gt;(about 20 weeks · each vendor follows the same 4 business steps)&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="1425" width="1820" height="36" as="geometry"/></mxCell><mxCell id="p1_rw1" value="W1" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="1468" width="78" height="30" as="geometry"/></mxCell><mxCell id="p1_rw2" value="W2" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="378" y="1468" width="78" height="30" as="geometry"/></mxCell><mxCell id="p1_rw3" value="W3" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="456" y="1468" width="78" height="30" as="geometry"/></mxCell><mxCell id="p1_rw4" value="W4" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="534" y="1468" width="78" height="30" as="geometry"/></mxCell><mxCell id="p1_rw5" value="W5" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="612" y="1468" width="78" height="30" as="geometry"/></mxCell><mxCell id="p1_rw6" value="W6" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="690" y="1468" width="78" height="30" as="geometry"/></mxCell><mxCell id="p1_rw7" value="W7" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="768" y="1468" width="78" height="30" as="geometry"/></mxCell><mxCell id="p1_rw8" value="W8" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="846" y="1468" width="78" height="30" as="geometry"/></mxCell><mxCell id="p1_rw9" value="W9" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="924" y="1468" width="78" height="30" as="geometry"/></mxCell><mxCell id="p1_rw10" value="W10" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1002" y="1468" width="78" height="30" as="geometry"/></mxCell><mxCell id="p1_rw11" value="W11" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="1468" width="78" height="30" as="geometry"/></mxCell><mxCell id="p1_rw12" value="W12" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1158" y="1468" width="78" height="30" as="geometry"/></mxCell><mxCell id="p1_rw13" value="W13" style="whiteSpace=wrap;html=1;fillColor=