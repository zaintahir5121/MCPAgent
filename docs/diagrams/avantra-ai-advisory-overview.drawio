<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="page1" name="1. High-Level Architecture"><mxGraphModel dx="1900" dy="1130" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1130" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_t" value="&lt;b style=&quot;font-size:28px&quot;&gt;Avantra AI Advisory Platform — High-Level Architecture&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1820" height="50" as="geometry"/></mxCell><mxCell id="p1_def" value="&lt;b&gt;What it does:&lt;/b&gt; turns a customer's business need into a &lt;b&gt;recommended vendor solution&lt;/b&gt; — which products, why they fit, what is missing, what to confirm for licensing — backed by &lt;b&gt;sources&lt;/b&gt; and &lt;b&gt;Avantra delivery experience&lt;/b&gt;, ready as an &lt;b&gt;advisory report&lt;/b&gt; for the customer." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0b3d91;strokeColor=#0b3d91;fontSize=15;align=left;verticalAlign=middle;spacing=8;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="1820" height="70" as="geometry"/></mxCell><mxCell id="p1_z0" value="Who asks" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="320" height="560" as="geometry"/></mxCell><mxCell id="p1_b0_0" value="&lt;b&gt;Account Executive&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;qualifying an opportunity&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="65" y="230" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b0_1" value="&lt;b&gt;Pre-sales Solution Consultant&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;shaping the solution&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="65" y="352" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b0_2" value="&lt;b&gt;Customer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;exploring options on the Marketplace&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="65" y="475" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b0_3" value="&lt;b&gt;Product Knowledge Owner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;keeps vendor knowledge current&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="65" y="597" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_z1" value="Where they ask" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="415" y="170" width="320" height="560" as="geometry"/></mxCell><mxCell id="p1_b1_0" value="&lt;b&gt;Nexa Chatbot&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;conversational advisory&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="440" y="230" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b1_1" value="&lt;b&gt;Advisory Workspace&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;web app for sales teams&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="440" y="393" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b1_2" value="&lt;b&gt;Avantra Marketplace&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&quot;Is this right for me?&quot;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="440" y="556" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_z2" value="Advisory Capabilities" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="790" y="170" width="320" height="560" as="geometry"/></mxCell><mxCell id="p1_b2_0" value="&lt;b&gt;Requirements Discovery&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;business need → requirement profile&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="815" y="230" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b2_1" value="&lt;b&gt;Solution Fit Analysis&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;match needs to vendor capabilities&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="815" y="352" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b2_2" value="&lt;b&gt;Licensing &amp;amp; Subscription Guidance&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;sizing inputs · what to confirm&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="815" y="475" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b2_3" value="&lt;b&gt;Advisory Report&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;recommendation · gaps · risks&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="815" y="597" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_z3" value="Vendor Knowledge" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="1165" y="170" width="320" height="560" as="geometry"/></mxCell><mxCell id="p1_b3_0" value="&lt;b&gt;Capability Model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;e.g. portfolio, resource, financial mgmt&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1190" y="230" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b3_1" value="&lt;b&gt;Product Catalogue&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;e.g. Planview Portfolios, AgilePlace&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1190" y="352" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b3_2" value="&lt;b&gt;Licensing Register&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;public / partner / not public&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1190" y="475" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b3_3" value="&lt;b&gt;Avantra Delivery Experience&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;fit rules · implementation lessons&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1190" y="597" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_z4" value="Advisory Outcome" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="1540" y="170" width="320" height="560" as="geometry"/></mxCell><mxCell id="p1_b4_0" value="&lt;b&gt;Recommended Solution&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;product bundle + why it fits&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1565" y="230" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b4_1" value="&lt;b&gt;Alternatives Compared&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;with their gaps&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1565" y="352" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b4_2" value="&lt;b&gt;Gaps, Risks &amp;amp; Next Questions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;what is still unknown&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1565" y="475" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_b4_3" value="&lt;b&gt;Customer-ready Report&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;after Solution Architect review&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1565" y="597" width="270" height="95" as="geometry"/></mxCell><mxCell id="p1_exh" value="&lt;b style=&quot;font-size:17px&quot;&gt;Example — a Planview opportunity&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="755" width="1820" height="34" as="geometry"/></mxCell><mxCell id="p1_s0" value="&quot;2,000 employees, 150 project managers, 40 portfolio managers — we need portfolio, resource and financial management&quot;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="795" width="320" height="120" as="geometry"/></mxCell><mxCell id="p1_s1" value="Asked through Nexa during a discovery call" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="415" y="795" width="320" height="120" as="geometry"/></mxCell><mxCell id="p1_s2" value="5 must-have requirements found · 6 clarifying questions (e.g. agile or waterfall?)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="790" y="795" width="320" height="120" as="geometry"/></mxCell><mxCell id="p1_s3" value="Planview Portfolios covers all 5 must-haves · AdaptiveWork + PPM Pro miss strategic planning" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1165" y="795" width="320" height="120" as="geometry"/></mxCell><mxCell id="p1_s4" value="Recommend Planview Portfolios · licence quote inputs: 40 portfolio mgrs, 150 PMs · pricing confirmed with Planview" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1540" y="795" width="320" height="120" as="geometry"/></mxCell><mxCell id="p1_rules" value="&lt;b&gt;Advisory principles:&lt;/b&gt; &amp;nbsp; recommendations come from the checked product catalogue, not from AI guesswork &amp;nbsp;·&amp;nbsp; every claim shows its source &amp;nbsp;·&amp;nbsp; &lt;b&gt;no prices or tiers unless the vendor publishes them&lt;/b&gt; &amp;nbsp;·&amp;nbsp; unknowns become clarifying questions &amp;nbsp;·&amp;nbsp; a Solution Architect reviews before the customer sees it" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="945" width="1820" height="60" as="geometry"/></mxCell><mxCell id="p1_foot" value="&lt;b&gt;Vendor domains:&lt;/b&gt; Planview now · Salesforce and OutSystems next — each is a new knowledge pack (capabilities, products, licensing, delivery experience). &amp;nbsp; &lt;b&gt;Built on:&lt;/b&gt; .NET 10 · Azure OpenAI · Azure AI Search · Azure SQL · Azure Container Apps." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1025" width="1820" height="60" as="geometry"/></mxCell><mxCell id="p1_a0" value="" style