d="p1_rl0" value="&lt;b&gt;Planview&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1508" width="250" height="44" as="geometry"/></mxCell><mxCell id="p1_rs0_0" value="&lt;b&gt;Build pack ✓&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="302" y="1508" width="152" height="44" as="geometry"/></mxCell><mxCell id="p1_rs0_1" value="&lt;b&gt;Verify facts&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="458" y="1508" width="230" height="44" as="geometry"/></mxCell><mxCell id="p1_rs0_2" value="&lt;b&gt;Sales pilot&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="692" y="1508" width="230" height="44" as="geometry"/></mxCell><mxCell id="p1_rs0_3" value="&lt;b&gt;Live in Nexa&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="926" y="1508" width="152" height="44" as="geometry"/></mxCell><mxCell id="p1_rl1" value="&lt;b&gt;Salesforce&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1560" width="250" height="44" as="geometry"/></mxCell><mxCell id="p1_rs1_0" value="&lt;b&gt;Build pack&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1082" y="1560" width="152" height="44" as="geometry"/></mxCell><mxCell id="p1_rs1_1" value="&lt;b&gt;Verify&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1238" y="1560" width="74" height="44" as="geometry"/></mxCell><mxCell id="p1_rs1_2" value="&lt;b&gt;Pilot&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1316" y="1560" width="74" height="44" as="geometry"/></mxCell><mxCell id="p1_rs1_3" value="&lt;b&gt;Live&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1394" y="1560" width="74" height="44" as="geometry"/></mxCell><mxCell id="p1_rl2" value="&lt;b&gt;OutSystems&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1612" width="250" height="44" as="geometry"/></mxCell><mxCell id="p1_rs2_0" value="&lt;b&gt;Build pack&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1472" y="1612" width="152" height="44" as="geometry"/></mxCell><mxCell id="p1_rs2_1" value="&lt;b&gt;Verify&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1628" y="1612" width="74" height="44" as="geometry"/></mxCell><mxCell id="p1_rs2_2" value="&lt;b&gt;Pilot&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1706" y="1612" width="74" height="44" as="geometry"/></mxCell><mxCell id="p1_rs2_3" value="&lt;b&gt;Live&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1784" y="1612" width="74" height="44" as="geometry"/></mxCell><mxCell id="p1_rl3" value="&lt;b&gt;All three together&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1664" width="250" height="44" as="geometry"/></mxCell><mxCell id="p1_rs3_0" value="&lt;b&gt;Combined advice&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1706" y="1664" width="152" height="44" as="geometry"/></mxCell><mxCell id="p1_rsteps" value="&lt;b&gt;The 4 steps per vendor:&lt;/b&gt; ① &lt;b&gt;Build pack&lt;/b&gt; — capability model, product catalogue, licensing register, documents &amp;nbsp; ② &lt;b&gt;Verify&lt;/b&gt; — Product Knowledge Owner checks every fact against official sources &amp;nbsp; ③ &lt;b&gt;Pilot&lt;/b&gt; — sales team uses it on real opportunities &amp;nbsp; ④ &lt;b&gt;Live&lt;/b&gt; — available in Nexa, the Workspace and the Marketplace. &amp;nbsp; &lt;b&gt;Combined advice&lt;/b&gt; e.g. Planview for portfolios + Salesforce for CRM + OutSystems for a custom portal, with how they connect." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="1715" width="1820" height="60" as="geometry"/></mxCell><mxCell id="p1_rules" value="&lt;b&gt;Advisory principles:&lt;/b&gt; &amp;nbsp; recommendations come from checked product catalogues, not AI guesswork &amp;nbsp;·&amp;nbsp; every claim shows its source &amp;nbsp;·&amp;nbsp; &lt;b&gt;no prices or tiers unless the vendor publishes them&lt;/b&gt; &amp;nbsp;·&amp;nbsp; unknowns become clarifying questions &amp;nbsp;·&amp;nbsp; a Solution Architect reviews before the customer sees it" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1790" width="1820" height="60" as="geometry"/></mxCell><mxCell id="p1_a0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=4;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_z0" target="p1_z1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=4;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_z1" target="p1_z2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=4;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_z2" target="p1_z3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565c0;strokeWidth=4;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_z3" target="p1_z4"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="2. Low-Level Design"><mxGraphModel dx="2500" dy="1560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2_t" value="&lt;b style=&quot;font-size:28px&quot;&gt;Low-Level Design — how a customer need becomes a recommendation&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="2400" height="50" as="geometry"/></mxCell><mxCell id="p2_zA" value="A. Advisory flow (one customer conversation)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2420" height="760" as="geometry"/></mxCell><mxCell id="p2_c1" value="&lt;b&gt;Customer Need&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;via Nexa · Workspace · Marketplace&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="230" height="90" as="geometry"/></mxCell><mxCell id="p2_c2" value="&lt;b&gt;Advisory API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;REST or MCP · same answers on every channel&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="330" width="230" height="90" as="geometry"/></mxCell><mxCell id="p2_st0" value="&lt;b&gt;1. Capture need&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;business description in plain words&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="330" width="225" height="90" as="geometry"/></mxCell><mxCell id="p2_ex0" value="&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;e.g. &quot;2,000 staff, 150 PMs, 40 portfolio managers…&quot;&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="340" y="445" width="225" height="105" as="geometry"/></mxCell><mxCell id="p2_st1" value="&lt;b&gt;2. Requirement profile&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;org size · personas · must / should / could&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="588" y="330" width="225" height="90" as="geometry"/></mxCell><mxCell id="p2_ex1" value="&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;e.g. 5 must-haves: portfolio, strategic planning, resource, financial, governance&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="588" y="445" width="225" height="105" as="geometry"/></mxCell><mxCell id="p2_st2" value="&lt;b&gt;3. Clarifying questions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;only for facts that change the answer&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="836" y="330" width="225" height="90" as="geometry"/></mxCell><mxCell id="p2_ex2" value="&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;e.g. Agile, waterfall or hybrid? How many resource managers?&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="836" y="445" width="225" height="105" as="geometry"/></mxCell><mxCell id="p2_st3" value="&lt;b&gt;4. Capability matching&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;requirements → vendor capability model&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1084" y="330" width="225" height="90" as="geometry"/></mxCell><mxCell id="p2_ex3" value="&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;e.g. portfolio-management · resource-management · financial-management …&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1084" y="445" width="225" height="105" as="geometry"/></mxCell><mxCell id="p2_st4" value="&lt;b&gt;5. Solution options&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;product bundles ranked by must-have coverage&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1332" y="330" width="225" height="90" as="geometry"/></mxCell><mxCell id="p2_ex4" value="&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;e.g. Recommended: Planview Portfolios (5/5) · Alternative: AdaptiveWork + PPM Pro (misses strategic planning)&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1332" y="445" width="225" height="105" as="geometry"/></mxCell><mxCell id="p2_st5" value="&lt;b&gt;6. Evidence&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;source for every claim · evidence grade&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1580" y="330" width="225" height="90" as="geometry"/></mxCell><mxCell id="p2_ex5" value="&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;e.g. Planview Portfolios overview · Planview solution areas&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1580" y="445" width="225" height="105" as="geometry"/></mxCell><mxCell id="p2_st6" value="&lt;b&gt;7. Licensing guidance&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;persona sizing inputs · quote needed&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1828" y="330" width="225" height="90" as="geometry"/></mxCell><mxCell id="p2_ex6" value="&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;e.g. 40 portfolio mgrs · 150 PMs → confirm licence types &amp;amp; pricing with Planview&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1828" y="445" width="225" height="105" as="geometry"/></mxCell><mxCell id="p2_st7" value="&lt;b&gt;8. Advisory report&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;recommendation · gaps · risks · next steps&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="2076" y="330" width="225" height="90" as="geometry"/></mxCell><mxCell id="p2_ex7" value="&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;e.g. Draft → Solution Architect review → shared with customer&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="2076" y="445" width="225" height="105" as="geometry"/></mxCell><mxCell id="p2_exlbl" value="&lt;b&gt;Planview example ↓&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="70" y="475" width="230" height="40" as="geometry"/></mxCell><mxCell id="p2_as1" value="&lt;b&gt;Requirement Taxonomy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;personas · priorities · methodology&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="588" y="600" width="225" height="90" as="geometry"/></mxCell><mxCell id="p2_as3" value="&lt;b&gt;Capability Model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Planview: 20 capabilities&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1084" y="600" width="225" height="90" as="geometry"/></mxCell><mxCell id="p2_as4" value="&lt;b&gt;Product Catalogue + Delivery Rules&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;which product covers what · Avantra experience&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1332" y="600" width="225" height="90" as="geometry"/></mxCell><mxCell id="p2_as5" value="&lt;b&gt;Knowledge Library&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;datasheets · product pages · playbooks&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1580" y="600" width="225" height="90" as="geometry"/></mxCell><mxCell id="p2_as6" value="&lt;b&gt;Licensing Register&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;not public / partner / public&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1828" y="600" width="225" height="90" as="geometry"/></mxCell><mxCell id="p2_as7" value="&lt;b&gt;Report Template&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Avantra advisory format&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="2076" y="600" width="225" height="90" as="geometry"/></mxCell><mxCell id="p2_ai" value="&lt;b&gt;Where AI is used&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;step 2: read the customer's words · step 8: write the summary — both checked against the catalogue&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="730" width="1200" height="80" as="geometry"/></mxCell><mxCell id="p2_noai" value="&lt;b&gt;Where AI is NOT used&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;choosing products · scoring · licensing — fixed rules, same answer every time&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1580" y="730" width="850" height="80" as="geometry"/></mxCell><mxCell id="p2_out" value="&lt;b&gt;Back to the customer conversation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;answers to clarifying questions refine the same session&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1998.5" y="160" width="380" height="90" as="geometry"/></mxCell><mxCell id="p2_loop" value="&lt;b&gt;Conversation loop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;customer answers → steps 2–8 run again with everything said so far&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="340" y="160" width="700" height="90" as="geometry"/></mxCell><mxCell id="p2_zB" value="B. Vendor knowledge lifecycle (keeps advice correct)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="2420" height="230" as="geometry"/></mxCell><mxCell id="p2_i0" value="&lt;b&gt;Collect&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;vendor datasheets · product pages · Avantra playbooks&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="940" width="268" height="95" as="geometry"/></mxCell><mxCell id="p2_i1" value="&lt;b&gt;Read&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PDF · Word · web pages&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="364" y="940" width="268" height="95" as="geometry"/></mxCell><mxCell id="p2_i2" value="&lt;b&gt;Screen&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;unsafe or suspicious content held back&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="658" y="940" width="268" height="95" as="geometry"/></mxCell><mxCell id="p2_i3" value="&lt;b&gt;Classify&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;by product and capability&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="952" y="940" width="268" height="95" as="geometry"/></mxCell><mxCell id="p2_i4" value="&lt;b&gt;Verify&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Product Knowledge Owner checks facts&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1246" y="940" width="268" height="95" as="geometry"/></mxCell><mxCell id="p2_i5" value="&lt;b&gt;Publish&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;into the knowledge library&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1540" y="940" width="268" height="95" as="geometry"/></mxCell><mxCell id="p2_i6" value="&lt;b&gt;Use in advice&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;cited in recommendations&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1834" y="940" width="268" height="95" as="geometry"/></mxCell><mxCell id="p2_i7" value="&lt;b&gt;Refresh&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;every 90 days · on vendor release&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="2128" y="940" width="268" height="95" as="geometry"/></mxCell><mxCell id="p2_zC" value="C. Business glossary (the language of the platform)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;fontStyle=1;verticalAlign=top;align=center;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="40" y="1130" width="2420" height="400" as="geometry"/></mxCell><mxCell id="p2_g0" value="&lt;b&gt;Vendor Domain&lt;/b&gt;&lt;br&gt;A technology vendor we advise on&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;e.g. Planview&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="1190" width="580" height="80" as="geometry"/></mxCell><mxCell id="p2_g1" value="&lt;b&gt;Capability&lt;/b&gt;&lt;br&gt;A business ability a product provides&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;e.g. Resource management&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="660" y="1190" width="580" height="80" as="geometry"/></mxCell><mxCell id="p2_g2" value="&lt;b&gt;Product&lt;/b&gt;&lt;br&gt;A vendor offering in the catalogue&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;e.g. Planview AgilePlace&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1250" y="1190" width="580" height="80" as="geometry"/></mxCell><mxCell id="p2_g3" value="&lt;b&gt;Coverage&lt;/b&gt;&lt;br&gt;How well a product delivers a capability&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;e.g. Core · Supported · Via integration&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1840" y="1190" width="580" height="80" as="geometry"/></mxCell><mxCell id="p2_g4" value="&lt;b&gt;Requirement&lt;/b&gt;&lt;br&gt;A customer need with a priority&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;e.g. Must: financial planning&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="1288" width="580" height="80" as="geometry"/></mxCell><mxCell id="p2_g5" value="&lt;b&gt;Requirement Profile&lt;/b&gt;&lt;br&gt;Organisation facts + requirements&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;e.g. 2,000 staff · 150 PMs&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="660" y="1288" width="580" height="80" as="geometry"/></mxCell><mxCell id="p2_g6" value="&lt;b&gt;Solution Option&lt;/b&gt;&lt;br&gt;A ranked product bundle&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;e.g. Portfolios + AgilePlace&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1250" y="1288" width="580" height="80" as="geometry"/></mxCell><mxCell id="p2_g7" value="&lt;b&gt;Gap&lt;/b&gt;&lt;br&gt;A requirement no product in the option covers&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;e.g. Strategic planning&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1840" y="1288" width="580" height="80" as="geometry"/></mxCell><mxCell id="p2_g8" value="&lt;b&gt;Evidence Grade&lt;/b&gt;&lt;br&gt;How strongly a claim is backed&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;e.g. Verified · Document · Catalogue&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="1386" width="580" height="80" as="geometry"/></mxCell><mxCell id="p2_g9" value="&lt;b&gt;Licensing Disclosure&lt;/b&gt;&lt;br&gt;Whether licence terms are public&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;e.g. Not public → quote needed&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="660" y="1386" width="580" height="80" as="geometry"/></mxCell><mxCell id="p2_g10" value="&lt;b&gt;Delivery Rule&lt;/b&gt;&lt;br&gt;Avantra experience, not a vendor fact&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;e.g. Hybrid teams → add AgilePlace&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=le