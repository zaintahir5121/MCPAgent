{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "AI": {
    "Provider": "OpenAICompatible",
    "Endpoint": "",
    "ApiKey": "",
    "ChatModel": "",
    "EmbeddingModel": "",
    "TimeoutSeconds": 60
  },

  "Database": { "Provider": "Sqlite" },
  "ConnectionStrings": { "Advisory": "Data Source=advisory.db" },

  "Knowledge": {
    "PacksPath": "knowledge/vendors",
    "IndexProvider": "InMemory",
    "SeedDocumentsOnStartup": true,
    "AzureAiSearch": {
      "Endpoint": "",
      "ApiKey": "",
      "IndexName": "advisory-knowledge",
      "VectorDimensions": 1536,
      "UseSemanticRanker": true
    }
  },

  "Auth": {
    "Mode": "EntraId",
    "EntraId": {
      "Instance": "https://login.microsoftonline.com/",
      "TenantId": "",
      "Audience": "api://avantra-ai-advisory",
      "ValidAudiences": [ "api://avantra-ai-advisory" ]
    },
    "ApiKey": { "Clients": [] }
  },

  "KeyVault": { "Uri": "" },
  "Cors": { "AllowedOrigins": [] }
}
