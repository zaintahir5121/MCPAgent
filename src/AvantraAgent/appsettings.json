{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AI": {
    "Endpoint": "",
    "ApiKey": "",
    "ChatModel": "",
    "EmbeddingModel": "",
    "TimeoutSeconds": 60
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Advisory": "Data Source=avantra-agent.db"
  },
  "Knowledge": {
    "PacksPath": "knowledge/vendors"
  },
  "Search": {
    "Provider": "InMemory",
    "Endpoint": "",
    "ApiKey": "",
    "VectorDimensions": 1536,
    "UseSemanticRanker": true
  },
  "KnowledgeBases": {
    "Seed": [
      {
        "Code": "planview",
        "Name": "Planview",
        "Description": "Planview products, solutions, documentation and licensing guidance (planview.com, success.planview.com and Avantra notes).",
        "IndexName": "planview-index",
        "SourceFolder": "knowledge/vendors/planview/documents",
        "SyncIntervalHours": 24,
        "Crawl": {
          "Sitemaps": [
            "https://www.planview.com/product-sitemap.xml",
            "https://www.planview.com/solution-sitemap.xml",
            "https://www.planview.com/guide-sitemap.xml",
            "https://www.planview.com/topic-sitemap.xml",
            "https://www.planview.com/acquisition-sitemap.xml",
            "https://www.planview.com/article-sitemap.xml",
            "https://www.planview.com/page-sitemap.xml",
            "https://success.planview.com/sitemap.xml"
          ],
          "StartUrls": [],
          "Include": [],
          "Exclude": [
            "/lp/*",
            "/cp/*",
            "/tl/*",
            "/ms/*",
            "/company/careers*",
            "/legal/*",
            "/thank-you*",
            "/Customer_Events/*",
            "/Feedback*",
            "/Special:*",
            "/@api/*",
            "/User:*",
            "/Template:*",
            "*trial*",
            "*/demo-request*",
            "*/contact*",
            "*/subscribe*"
          ],
          "MaxPages": 15000,
          "MinDelayMs": 1000,
          "Trust": "VendorOfficial"
        }
      }
    ]
  },
  "Ingestion": {
    "StagingPath": "data/staging",
    "AllowedSourceRoot": "knowledge",
    "AllowedUrlHosts": [
      "www.planview.com",
      "success.planview.com"
    ],
    "MaxFileSizeMb": 25,
    "MaxFilesPerUpload": 20,
    "QueueCapacity": 200,
    "PublishUploadsByDefault": true,
    "SyncOnStartup": true,
    "CrawlOnStartup": false
  },
  "Security": {
    "AdminApiKey": "",
    "AllowedOrigins": []
  },
  "RateLimits": {
    "ChatPerMinute": 60,
    "AdminPerMinute": 30
  },
  "Connectors": {
    "Planview": {
      "Api": {
        "BaseUrl": "",
        "ApiKey": ""
      }
    }
  },
  "KeyVault": {
    "Uri": ""
  }
}