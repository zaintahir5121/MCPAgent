{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
  "AllowedHosts": "*",

  "AI": {
    "Endpoint": "",
    "ApiKey": "",
    "ChatModel": "",
    "EmbeddingModel": "",
    "TimeoutSeconds": 60
  },

  "Database": { "Provider": "Sqlite" },
  "ConnectionStrings": { "Advisory": "Data Source=avantra-agent.db" },

  "Knowledge": { "PacksPath": "knowledge/vendors" },

  "Search": {
    "Provider": "InMemory",
    "Endpoint": "",
    "ApiKey": "",
    "VectorDimensions": 1536,
    "UseSemanticRanker": true
  },

  "KnowledgeBases": {
    "Seed": [
      {
        "Code": "planview",
        "Name": "Planview",
        "Description": "Planview portfolio and work management products, capabilities and licensing guidance.",
        "IndexName": "planview-index",
        "SourceFolder": "knowledge/vendors/planview/documents",
        "SyncIntervalHours": 24
      }
    ]
  },

  "Ingestion": {
    "StagingPath": "data/staging",
    "AllowedSourceRoot": "knowledge",
    "AllowedUrlHosts": [],
    "MaxFileSizeMb": 25,
    "MaxFilesPerUpload": 20,
    "QueueCapacity": 200,
    "PublishUploadsByDefault": true,
    "SyncOnStartup": true
  },

  "Security": {
    "AdminApiKey": "",
    "AllowedOrigins": []
  },

  "RateLimits": { "ChatPerMinute": 60, "AdminPerMinute": 30 },

  "Connectors": {
    "Planview": { "Api": { "BaseUrl": "", "ApiKey": "" } }
  },

  "KeyVault": { "Uri": "" }
}
